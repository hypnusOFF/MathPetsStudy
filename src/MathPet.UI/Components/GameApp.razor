@namespace MathPet.UI.Components
@inject GameState Game
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!loaded)
{
    <div class="empty"><h1>数学宠物岛</h1><p class="muted">正在准备你和团团的小岛…</p></div>
}
else
{
<div class="shell">
<aside class="sidebar">
    <div class="brand"><span class="brand-icon">✦</span>数学宠物岛</div>
    <div class="side-caption">LEARN · PLAY · GROW</div>
    <nav class="nav" aria-label="主导航">
    @foreach (var nav in Navigation)
    {
        <button class="navbtn @(ActiveNav(nav.Page) ? "active" : "")" @onclick="() => Navigate(nav.Page)" aria-current="@(ActiveNav(nav.Page) ? "page" : null)"><span>@nav.Icon</span>@nav.Label</button>
    }
    </nav>
    <div class="side-pet"><b>🌱 每一点进步，都有陪伴</b><p>学会一个新知识，也让你的小伙伴长大一点。</p><button class="btn secondary" @onclick="() => Navigate(View.Pet)">去看看@(State.PetName) →</button></div>
</aside>
<main class="content">
<header class="topbar"><div><div class="eyebrow">MATH & LITTLE FRIENDS</div><h1>@PageTitle</h1></div><div class="wallet"><span class="coin" data-testid="wallet">✦ @State.Coins 积分</span><span class="avatar">🙂</span></div></header>
@if (Game.StorageError is not null) { <div class="storage-error" role="alert">@Game.StorageError</div> }
@switch (view)
{
case View.Home:
    <div class="hero"><div><span class="pill">🌱 学数学 · 养伙伴</span><h2>每一次思考，<br>都让小岛更美好。</h2><p class="muted">从一个知识点开始。@(State.PetName) 已经准备好，陪你一起学习、挑战和成长。</p><div class="flex"><button class="btn" @onclick="() => Navigate(View.Courses)">开始学习 →</button><button class="btn ghost" @onclick="() => Navigate(View.Pet)">看看@(State.PetName)</button></div></div><PetPortrait Species="@State.ActiveSpecies" Stage="@VisualStage" Name="@State.PetName" Headwear="@State.ActivePet.Headwear" Outfit="@State.ActivePet.Outfit" Accessory="@State.ActivePet.Accessory" HideStageDecoration="@State.ActivePet.HideStageDecoration" ReducedMotion="@State.ReducedMotion" /></div>
    <div class="section"><h2>我的学习计划</h2><span class="muted tiny">按自己的节奏，一步一步来</span></div>
    <div class="grid">
        <div class="card"><span class="icon">▤</span><h3>继续学 · @Topic.Name</h3><p class="muted tiny">@GradeName 年级 · @(State.Semester == Semester.First ? "上册" : "下册")</p><button class="btn secondary" @onclick="OpenLesson">进入课堂</button></div>
        <div class="card"><span class="icon" style="background:#e9f5ef">✎</span><h3>今天的小练习</h3><p class="muted tiny">6道题 · 不限时 · 今日首次完成额外 +10</p><button class="btn secondary" @onclick="() => Navigate(View.Daily)">开始练习</button></div>
        <div class="card"><span class="icon" style="background:#fff2d8">⚑</span><h3>挑战知识点关卡</h3><p class="muted tiny">独立思考 · 解锁星星与积分</p><button class="btn secondary" @onclick="() => Navigate(View.Map)">去闯关</button></div>
    </div>
    <div class="section"><h2>一起成长</h2></div><div class="two">
    <div class="card"><div class="row"><div><h3>📚 学习足迹</h3><span class="muted tiny">认真练习，才能逐渐掌握</span></div></div><div class="flex" style="justify-content:space-around;margin-top:20px"><div><div class="stat">@State.CompletedPractices</div><span class="muted tiny">完成练习</span></div><div><div class="stat">@State.Stars.Count</div><span class="muted tiny">通过关卡</span></div><div><div class="stat">@State.Mistakes.Count</div><span class="muted tiny">待复习错题</span></div></div></div>
    <div class="card"><span class="tag">主宠物 · @(State.PetName)</span><h3>今天也想和你一起玩！</h3><p class="muted">Lv.@State.ActivePet.Level · 经验 @State.ActivePet.Experience/@PetProgress.MaxExperience · @Engine.PetStage</p><div class="progress"><i style="width:@(State.ActivePet.Experience*100/PetProgress.MaxExperience)%"></i></div><button class="btn secondary" @onclick="() => Navigate(View.Pet)">回到宠物家园 →</button></div></div>
    break;
case View.Courses:
    <p class="muted">年级 → 学期 → 单元 → 知识点 → 讲解与练习</p>
    <GradeSelector Grade="State.Grade" Semester="State.Semester" ShowSemester="true" Changed="ChangeGrade" SemesterChanged="ChangeSemester" />
    <div class="note">原创题库按小学知识范围编排。选择一个知识点，先看讲解，再练习不同题型。</div>
    <div class="section"><h2>@GradeName 年级 · @(State.Semester == Semester.First ? "上册" : "下册")</h2><span class="muted tiny">@SemesterTopics.Count 个知识点</span></div>
    @foreach (var unit in SemesterTopics.GroupBy(t => t.UnitName))
    {
        <h3>@unit.Key</h3>
        <div class="grid">
        @foreach (var topic in unit)
        {
            <div class="card" data-topic-id="@topic.Id"><span class="tag purple">@topic.Area</span><h3>@topic.Name</h3><p class="muted tiny">@topic.Questions.Select(q => q.QuestionType).Distinct().Count() 类题型 · @topic.Questions.Count 道练习 · 配套相似题</p><p class="muted tiny">@MasteryLabel(Engine.GetMastery(topic))</p><button class="btn" @onclick="() => OpenTopic(topic)">去学习 →</button></div>
        }
        </div>
    }
    break;
case View.Lesson:
    <button class="btn ghost" @onclick="() => Navigate(View.Courses)">← 课程目录</button>
    <details class="card video-list"><summary>相关免费教学视频</summary><p class="muted tiny">@TeachingResources.ForTopic(Topic.Id).Status。将在B站外部打开，需要网络；免费状态按最近核查记录，平台可能调整。</p>@foreach(var video in TeachingResources.ForTopic(Topic.Id).Videos){<p><a href="@video.Url" target="_blank" rel="noopener noreferrer">@video.Title</a></p>}</details>
    <div class="lesson-steps" aria-label="学习步骤">
        @for (var i=0; i<LessonSteps.Length; i++) { var index=i; <button class="@(lessonStep==index?"active":"")" @onclick="() => lessonStep=index">@(index+1). @LessonSteps[index]</button> }
    </div>
    <div class="card">
    @switch(lessonStep)
    {
        case 0:
            <span class="tag">本课目标</span><h2>@Topic.Name</h2><p class="big-problem">@Topic.Goal</p><p class="muted">先理解，再练习。提示始终免费，答错也可以继续学习。</p>
            break;
        case 1:
            <h2>@Topic.Name</h2><div class="step">@Topic.Explanation</div>@if(Topic.Questions[0].Interaction is not null){<MathDiagram Question="@Topic.Questions[0]" ReadOnly="true" />}<div class="big-problem" style="text-align:center;background:#fff7e7;padding:25px;border-radius:16px">@Topic.Visual</div><p class="muted">常见提醒：@Topic.Questions[0].CommonMistake</p>
            break;
        case 2:
            <span class="tag">分步例题</span><h2>@Topic.Questions[0].Text</h2>
            @for(var i=0;i<Topic.ExampleSteps.Length;i++) { <details class="step" open="@(i==0)"><summary>第 @(i+1) 步</summary><p>@Topic.ExampleSteps[i]</p></details> }
            break;
        case 3:
            <span class="tag">引导练习</span><h2>@Topic.Questions[1].Text</h2><p class="muted">先想一想应该用什么方法，再展开提示。</p>
            @for(var i=0;i<Topic.Questions[1].Hints.Length;i++) { <details class="step"><summary>提示 @(i+1)</summary><p>@Topic.Questions[1].Hints[i]</p></details> }
            <details class="step"><summary>查看完整做法</summary>@foreach(var step in Topic.Questions[1].Solution) { <p>@step</p> }</details>
            <p class="muted tiny">下一步可以独立输入答案，获得判分和反馈。</p>
            break;
        case 4:
            <h2>自己试一试</h2><p class="muted">每轮从不同题型中选题，不限时；多练几轮会换用新参数题。</p><button class="btn" @onclick="() => Start(StudyMode.Practice)">开始独立练习 →</button>
            break;
        case 5:
            <h2>准备挑战了吗？</h2><p class="muted">独立答对至少三分之二的题目通过本关。使用提示的题目仍有积分，但不计入独立通关题数。</p><button class="btn" @onclick="() => Start(StudyMode.Challenge)">开始知识点闯关 ⚑</button>
            break;
    }
        <div class="flex" style="margin-top:25px;justify-content:space-between"><button class="btn ghost" disabled="@(lessonStep==0)" @onclick="() => lessonStep--">上一步</button>@if(lessonStep<5) {<button class="btn secondary" @onclick="() => lessonStep++">下一步 →</button>}</div>
    </div>
    break;
case View.Daily:
    <GradeSelector Grade="State.Grade" Semester="State.Semester" ShowSemester="true" Changed="ChangeGrade" SemesterChanged="ChangeSemester" />
    <div class="hero"><div><span class="pill">练习模式 · 不限时</span><h2>温习一点，巩固一点。</h2><p class="muted">从当前年级和学期选6道题，优先选择练得较少的知识点，并加入已有错题。</p><button class="btn" @onclick="() => Start(StudyMode.Daily)">开始今日练习 →</button></div><div style="font-size:75px">✎</div></div>
    <div class="grid" style="margin-top:20px"><div class="card"><h3>当前知识</h3><p class="muted">@Topic.Name</p></div><div class="card"><h3>学习积分</h3><p class="muted">年级系数 @GameEngine.GradeMultipliers[State.Grade-1] · 今日首次完成额外 +10</p></div><div class="card"><h3>错题巩固</h3><p class="muted">@State.Mistakes.Count 道待复习</p><button class="btn secondary" @onclick="() => Navigate(View.Review)">去复习</button></div></div>
    <div class="note">题目基础分10 × 年级系数 × 难度系数。使用提示奖励为60%，重复做对奖励为30%。答错不扣分。</div>
    break;
case View.Map:
    <GradeSelector Grade="State.Grade" Semester="State.Semester" ShowSemester="true" Changed="ChangeGrade" SemesterChanged="ChangeSemester" />
    <div class="hero"><div><span class="pill">知识点 → 单元 → 学期</span><h2>向下一颗星星出发。</h2><p class="muted">可以挑战知识点、单元或学期综合关。综合关从多个知识点选题。</p></div><div style="font-size:70px">🏁</div></div>
    <div class="section"><h2>我的闯关路线</h2><span class="muted tiny">@GradeName 年级 · 年级系数 @GameEngine.GradeMultipliers[State.Grade-1]</span></div>
    <div class="grid">
    @foreach(var topic in SemesterTopics)
    {
        <div class="card" data-topic-id="@topic.Id"><span class="tag">@topic.UnitName</span><h3>@topic.Name</h3><p class="muted tiny">不同题型组合 · 独立答对至少三分之二通过 · 按题型限时</p><div class="stars">@StarText(State.Stars.GetValueOrDefault(topic.Id))</div><button class="btn" @onclick="() => ChallengeTopic(topic)">@(State.Stars.ContainsKey(topic.Id)?"再次挑战":"开始闯关")</button></div>
    }
    </div>
    <div class="section"><h2>综合挑战</h2></div><div class="grid">
    @foreach(var unit in SemesterTopics.Where(t=>t.Order!=1000).Select(t=>t.UnitName).Distinct()){var name=unit;var key=$"comprehensive:{State.Grade}:{State.Semester}:{unit}";<div class="card"><h3>@unit</h3><span class="stars">@StarText(State.Stars.GetValueOrDefault(key))</span><button class="btn secondary" @onclick="()=>Comprehensive(name)">单元综合关</button></div>}
    <div class="card"><h3>学期综合关</h3><span class="stars">@StarText(State.Stars.GetValueOrDefault($"comprehensive:{State.Grade}:{State.Semester}:semester"))</span><button class="btn" @onclick="()=>Comprehensive(null)">挑战本学期</button></div></div>
    <div class="note">时限为初始建议，按题型设置为30～120秒。超时后仍能作答，只失去速度奖励，不影响正确答案获得积分。退出后已获得的题目积分保留。</div>
    break;
case View.Quiz:
    @if(quiz is not null)
    {
        <div class="flex" style="justify-content:space-between"><button class="btn ghost" @onclick="() => Navigate(View.Home)">← 退出练习</button><span class="tag purple">第 @(quiz.Index+1) / @quiz.Questions.Count 题</span><span class="muted tiny">@if(quiz.IsChallenge){<span>⏱ <span class="timer" data-testid="timer">@(quiz.TimedOut?"已超时 · 可继续作答":$"{quiz.RemainingSeconds}秒")</span></span>}else{<span>不限时 · 可以慢慢想</span>}</span></div>
        <div class="progress"><i style="width:@(quiz.Index*100/quiz.Questions.Count)%"></i></div>
        <div class="card" style="margin-top:20px"><span class="tag">@Curriculum.GradeNames[quiz.Topic.Grade-1]年级 · @quiz.Topic.Name</span>
        @if(quiz.Mode==StudyMode.Review){<p class="muted tiny">这是一道相似题。独立答对后，可移除对应错题；用提示做对则保留，方便再巩固。</p>}
        <span class="tag">@quiz.Current.QuestionType · @Curriculum.FindTopic(quiz.Current.TopicId).Name</span>
        <div class="big-problem" data-testid="question">@quiz.Current.Text</div>
        @if(quiz.Current.Interaction is not null){<MathDiagram Question="@quiz.Current" ReadOnly="@quiz.Answered" AnswerChanged="v=>answerText=v" />}
        <div class="learning-pet"><PetPortrait Species="@rewardSpecies" Stage="@RewardPet.Stage" Headwear="@RewardPet.Headwear" Outfit="@RewardPet.Outfit" Accessory="@RewardPet.Accessory" HideStageDecoration="@RewardPet.HideStageDecoration" Name="@rewardName" Trigger="@feedbackAction" ReducedMotion="@State.ReducedMotion" /></div>
        @if(quiz.Current.Options.Length > 0)
        {
            <div class="flex">@for(var i=0;i<quiz.Current.Options.Length;i++){var option=i;<button class="btn secondary" disabled="@quiz.Answered" @onclick="() => answerText=option.ToString()">@option：@quiz.Current.Options[i]</button>}</div>
        }
        <form class="answer-form" @onsubmit="Submit" @onsubmit:preventDefault>
            <label class="muted tiny" for="answer">@(quiz.Current.Interaction=="clock"?"拨动钟面，或输入时:分，如3:30":quiz.Current.Interaction=="reflect"?"点击网格交点，或输入坐标，如(6,2)":quiz.Topic.Grade==5?"请输入分数，如5/6；等值分数也可":"请输入数字，题目中的单位可省略")</label><br>
            <input id="answer" class="answer" @bind="answerText" @bind:event="oninput" autocomplete="off" maxlength="100" placeholder="写下你的答案" disabled="@quiz.Answered" @ref="answerInput" />
            @if(answerError is not null){<p class="error-text" role="alert">@answerError</p>}
            <div class="flex"><button type="submit" class="btn" disabled="@quiz.Answered" data-testid="submit-answer">提交答案</button><button type="button" class="btn secondary" disabled="@(quiz.Answered || quiz.HintCount>=quiz.Current.Hints.Length)" @onclick="Hint">💡 给我一点提示</button></div>
        </form>
        @foreach(var hint in revealedHints){<div class="step">💡 @hint</div>}
        @if(quiz.Answered && quiz.LastResult is { } result)
        {
            <div class="feedback @(result.Correct?"":"bad")" role="status" data-testid="answer-feedback"><b>@(result.Correct?$"答对啦！ +{result.Points} 积分":"这次还差一点，看看怎么做。")</b><p>你的答案：@result.Submitted</p><p>解题思路：</p>@foreach(var step in result.Question.Solution){<p>@step</p>}@if(!result.Correct){<p>常见错误：@result.Question.CommonMistake</p>}<span class="tiny">@(result.Correct?"认真思考比速度更重要。":"已加入错题复习，答错不会扣积分。")</span></div>
            <button class="btn" @onclick="Next" data-testid="next-question">@(quiz.Index<quiz.Questions.Count-1?"下一题 →":"查看结算 →")</button>
        }
        </div>
    }
    break;
case View.Result:
    @if(summary is not null)
    {
        <div class="card empty"><div style="font-size:60px">@(summary.Mode is StudyMode.Challenge or StudyMode.UnitChallenge or StudyMode.SemesterChallenge?(summary.Passed?"🏆":"🌱"):"🎉")</div><div class="result-pet"><PetPortrait Species="@rewardSpecies" Stage="@RewardPet.Stage" Headwear="@RewardPet.Headwear" Outfit="@RewardPet.Outfit" Accessory="@RewardPet.Accessory" HideStageDecoration="@RewardPet.HideStageDecoration" Name="@rewardName" Trigger="@resultAction" ReducedMotion="@State.ReducedMotion" /></div><h2>@(summary.Mode is StudyMode.Challenge or StudyMode.UnitChallenge or StudyMode.SemesterChallenge?(summary.Passed?"挑战成功！":"再巩固一下就更好了"):"练习完成！")</h2><p class="muted">答对 @summary.Correct / @summary.Total 道 · @summary.TopicName</p>@if(summary.Mode is StudyMode.Challenge or StudyMode.UnitChallenge or StudyMode.SemesterChallenge){<div class="stars">@StarText(summary.Stars)</div>}<div class="stat" style="color:var(--purple)">+@(summary.QuestionPoints+summary.CompletionBonus) 积分</div><p class="muted tiny">题目奖励 @summary.QuestionPoints · 完成奖励 @summary.CompletionBonus<br>@(rewardName) 经验 +@summary.GrowthGained</p><p class="muted tiny">@(summary.Mode==StudyMode.Review?"独立答对相似题后移除错题；使用提示后仍保留以便复习。":"错题已保存。通过关卡后继续复习，才能巩固掌握。")</p><div class="flex" style="justify-content:center;margin-top:25px"><button class="btn" @onclick="() => Navigate(View.Pet)">去照顾@(State.PetName) ♡</button><button class="btn secondary" @onclick="() => Navigate(View.Review)">复习错题</button><button class="btn ghost" @onclick="() => Navigate(View.Home)">回到首页</button></div></div>
    }
    break;
case View.Review:
    <p class="muted">先看懂错在哪里，再用相似题独立练习。使用提示做对不会立即移除错题。</p>
    @if(State.Mistakes.Count==0){<div class="card empty"><div style="font-size:55px">🌿</div><h2>这里暂时没有错题</h2><p class="muted">练习中答错的题目会自动来到这里。</p><button class="btn" @onclick="() => Navigate(View.Daily)">去做每日练习</button></div>}
    @foreach(var mistake in State.Mistakes.ToList())
    {
        var question=Curriculum.FindQuestion(mistake.QuestionId);
        @if(question is not null){<div class="card" style="margin-top:15px" @key="mistake.QuestionId"><span class="tag purple">@Curriculum.GradeNames[question.Grade-1]年级 · 待巩固</span><h3>@question.Text</h3><p class="muted tiny">上次答案：@mistake.LastAnswer · 错误 @mistake.WrongCount 次</p><details class="step"><summary>查看解题思路</summary>@foreach(var step in question.Solution){<p>@step</p>}<p>常见错误：@question.CommonMistake</p></details><button class="btn secondary" @onclick="() => Start(StudyMode.Review,mistake.QuestionId)">试试相似题</button></div>}
    }
    break;
case View.Pet:
    <div class="two"><div class="card"><div class="flex" style="justify-content:space-between;margin-bottom:15px"><div><span class="tag">我的主宠物</span><h2 style="margin:9px 0">@(State.PetName) <span class="muted" style="font-size:14px">@Engine.PetStage</span></h2></div><div class="flex"><button class="btn ghost" @onclick="Rename">改名字</button><button class="btn ghost" @onclick="() => Navigate(View.Growth)">成长册 →</button></div></div>
        <div class="pet-scene" style="background: url('_content/MathPet.UI/pet-decor/room-@(State.Room).png') center/cover"><div class="bubble">@(State.ActivePet.Headwear!=""?"今天戴上了新头饰！":"今天想和你一起学数学！")</div><PetPortrait Species="@State.ActiveSpecies" Stage="@VisualStage" Name="@State.PetName" Headwear="@State.ActivePet.Headwear" Outfit="@State.ActivePet.Outfit" Accessory="@State.ActivePet.Accessory" HideStageDecoration="@State.ActivePet.HideStageDecoration" ReducedMotion="@State.ReducedMotion" @ref="petPortrait" /></div>
        <div class="flex" style="justify-content:center;margin-top:18px"><button class="btn secondary" @onclick="Feed" data-testid="feed">🍎 喂食 (@State.Food)</button><button class="btn secondary" @onclick="Play">🧶 玩耍</button><button class="btn secondary" @onclick="Care">✨ 清洁 / 抚摸</button></div></div>
    <div><div class="card"><h3 style="margin-top:0">@(State.PetName) 的状态</h3>@foreach(var stat in new[]{("饱腹",State.Fullness,"#dfb066"),("心情",State.Mood,"#8cb7a2"),("满级经验进度",State.ActivePet.Experience*100/PetProgress.MaxExperience,"#a28ae8")}){<div class="row" style="display:block"><div class="flex" style="justify-content:space-between"><span>@stat.Item1</span><span class="muted tiny">@stat.Item2 / 100</span></div><div class="progress"><i style="width:@(stat.Item2)%;background:@stat.Item3"></i></div></div>}<p class="muted tiny">不会死亡，等级不会倒退。饱腹最低30，心情最低40，离开几天也没关系。</p></div>
        <div class="card" style="margin-top:18px"><div class="flex"><button class="btn gold" @onclick="() => Navigate(View.Shop)">小岛商店</button><button class="btn ghost" @onclick="() => Navigate(View.Bag)">我的背包</button></div><p class="muted tiny">用学习积分购买食物、玩具和装饰。</p></div></div></div>
    <div class="section"><h2>我的三位伙伴</h2><span class="muted tiny">各自成长，积分和背包共享</span></div><div class="grid pet-collection">
    @foreach(var pet in State.Pets){<div class="card pet-choice" data-pet="@pet.Species"><PetPortrait Species="@pet.Species" Stage="@pet.Stage" Name="@pet.Name" Headwear="@pet.Headwear" Outfit="@pet.Outfit" Accessory="@pet.Accessory" HideStageDecoration="@pet.HideStageDecoration" ReducedMotion="@State.ReducedMotion"/><h3>@pet.Name · Lv.@pet.Level</h3><p class="muted tiny">经验 @pet.Experience · 饱腹 @pet.Fullness · 心情 @pet.Mood</p><button class="btn secondary" disabled="@(pet.Species==State.ActiveSpecies)" @onclick="()=>SelectPet(pet.Species)">@(pet.Species==State.ActiveSpecies?"当前主力":"设为主力")</button></div>}
    </div><div class="card settings"><h3>表现设置</h3><label><input type="checkbox" @bind="State.ReducedMotion" @bind:after="SettingsChanged"/> 减少动画</label><label><input type="checkbox" @bind="State.SoundEnabled" @bind:after="SettingsChanged"/> 播放音效</label><p class="muted tiny">不影响学习奖励，设置保存在本设备。</p></div>

    break;
case View.Shop:
case View.Bag:
    <div class="flex"><button class="btn ghost" @onclick="() => Navigate(View.Pet)">← 宠物家园</button><button class="btn secondary" @onclick="() => Navigate(view==View.Shop?View.Bag:View.Shop)">@(view==View.Shop?"查看背包":"去商店")</button></div><p class="muted">把每一点学习收获，变成@(State.PetName) 的小小快乐。</p>
    <div class="grid shop">@foreach(var item in GameEngine.Shop.Where(i=>i.Kind!=ItemKind.Ribbon))
    {
        <div class="card shop-item"><PetDecoration Icon="true" Id="@(item.Kind==ItemKind.Food?"apple":item.Kind==ItemKind.Toy?"yarn":"book")" Class="item-art" Label="@item.Name"/><h3>@item.Name</h3><p class="muted tiny">@item.Description</p>
        @if(view==View.Shop){<p class="coin">✦ @item.Price 积分</p><button class="btn @(item.Kind==ItemKind.Food?"gold":"secondary")" disabled="@(State.Coins<item.Price || item.Kind!=ItemKind.Food && Engine.Owns(item.Kind))" @onclick="() => Buy(item.Kind)">@(item.Kind!=ItemKind.Food && Engine.Owns(item.Kind)?"已拥有":"购买")</button>}
        else {<p class="muted">拥有 @(item.Kind==ItemKind.Food?State.Food:Engine.Owns(item.Kind)?1:0) @(item.Kind==ItemKind.Food?"份":"件")</p><button class="btn secondary" disabled="@(!Engine.Owns(item.Kind))" @onclick="() => Use(item.Kind)">@UseLabel(item.Kind)</button>}
        </div>
    }</div>
    <div class="section"><h2>衣饰与穿搭</h2></div>
    @if(view==View.Bag){<div class="flex">@foreach(var slot in new[]{"head","body","accessory"}){var category=slot;<button class="btn ghost" @onclick="() => RemoveClothes(category)">卸下@(slot=="head"?"头饰":slot=="body"?"衣服":"饰品")</button>}<button class="btn ghost" @onclick="RestoreDecoration">恢复进化配饰</button></div>}
    <div class="grid shop">@foreach(var item in GameEngine.Wardrobe){<div class="card shop-item"><PetDecoration Id="@item.Id" Class="item-art" Label="@item.Name"/><h3>@item.Name</h3>@if(view==View.Shop){<p class="coin">@item.Price 积分</p><button class="btn secondary" disabled="@(State.Coins<item.Price||State.OwnedWearables.Contains(item.Id))" @onclick="()=>BuyClothes(item.Id)">@(State.OwnedWearables.Contains(item.Id)?"已拥有":"购买衣饰")</button>}else{<button class="btn secondary" disabled="@(!State.OwnedWearables.Contains(item.Id))" @onclick="()=>Equip(item.Slot,item.Id)">穿给@(State.PetName)</button>}</div>}</div>
    <div class="section"><h2>家园</h2></div><div class="flex">@foreach(var room in new[]{"study","spring","stars"}){var selected=room;<button class="btn secondary" disabled="@(room!="study"&&!State.HasRoom)" @onclick="()=>ChangeRoom(selected)">@(room=="study"?"学习角":room=="spring"?"春日小屋":"星光小屋")</button>}</div>
    <div class="note">积分不会因答错扣除。低年级也能负担基础食物，高年级积分更多，可用于丰富家园。所有物品与进度保存在本设备。</div>
    break;
case View.Growth:
    <button class="btn ghost" @onclick="() => Navigate(View.Pet)">← 宠物家园</button><div class="hero" style="margin-top:20px"><div><span class="pill">@(State.PetName) 的成长故事</span><h2>一起学习，一起长大。</h2><p class="muted">答对题目和喂食积累经验，达到6级和13级时进化。各年级都能达成，无需挑战高年级课程。</p></div><PetPortrait Species="@State.ActiveSpecies" Stage="@VisualStage" Name="@State.PetName" Headwear="@State.ActivePet.Headwear" Outfit="@State.ActivePet.Outfit" Accessory="@State.ActivePet.Accessory" HideStageDecoration="@State.ActivePet.HideStageDecoration" ReducedMotion="@State.ReducedMotion" /></div>
    <div class="section"><h2>等级与进化</h2><span class="muted tiny">@State.PetName · Lv.@State.ActivePet.Level</span></div><div class="grid">@foreach(var stage in new[]{("幼年期",1,5),("初次进化",6,12),("最终进化",13,20)}){<div class="card"><h3>@stage.Item1 · Lv.@stage.Item2–@stage.Item3</h3><p class="muted tiny">@(stage.Item2==1?"没有装饰，开始陪伴。":stage.Item2==6?"解锁简单小配饰。":"毛色纹路出现，继续积累到20级。")</p><span class="tag">@(State.ActivePet.Level>=stage.Item2?"已到达":"继续积累经验")</span></div>}</div>
    <p class="note">下一等级累计经验：@(State.ActivePet.Level==20?"已满级":PetProgress.RequiredExperience(State.ActivePet.Level+1).ToString())。练习奖励归开始时选定的伙伴；玩耍和抚摸不会刷经验。</p>
    <div class="section"><h2>学习成就</h2></div><div class="card"><div class="row"><span>✦ 第一次关卡通关</span><span class="tag">@(State.Stars.Count>0?"已获得":"继续加油")</span></div><div class="row"><span>✎ 完成一次日常练习</span><span class="tag">@(State.CompletedPractices>0?"已获得":"继续加油")</span></div><div class="row"><span>↺ 独立答对一题相似题</span><span class="tag">@(State.ReviewedMistakes>0?"已获得":"继续加油")</span></div><p class="muted tiny">三只伙伴分别保存经验，等级不会倒退。</p></div>
    break;
}
<div class="footer">数学宠物岛 · 离线学习与三宠物养成<br>@Curriculum.Topics.Count 个知识点 · 原创题库 · 教材最新版十二册目录尚未逐册核定<br><button @onclick="Reset">重置本机进度</button></div>
</main></div>
@if(toast is not null){<div class="toast" role="status">@toast</div>}
@if(modalTitle is not null)
{
<div class="modal" @onkeydown="ModalKey"><div class="card" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" @ref="modalElement"><h2 id="modal-title">@modalTitle</h2><p class="muted">@modalText</p>
@if(renaming){<label for="pet-name">宠物名字（1～12个字符）</label><input id="pet-name" class="name-input" maxlength="12" @bind="newPetName" @bind:event="oninput" />}
@if(modalError is not null){<p class="error-text" role="alert">@modalError</p>}
<div class="flex modal-actions"><button class="btn ghost" @onclick="CancelModal">取消</button><button class="btn" @onclick="ConfirmModal" disabled="@modalBusy">@(modalBusy?"处理中…":modalButton)</button></div></div></div>
}
}
