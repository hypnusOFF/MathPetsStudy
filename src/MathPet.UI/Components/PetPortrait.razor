@implements IDisposable
<div class="pet-art" style="animation:none">
    <div class="pet-motion" data-action="@action" data-motion="@(ReducedMotion ? "reduced" : "full")" style="--pet-duration:@(Duration(action))ms" @key="serial">
        <span class="pet-shadow" aria-hidden="true"></span>
        <img class="pet-sprite sprite-@(Species)-@(Stage)" src="@Sprite(Stage)" alt="@Name" draggable="false" />
        @if (action == "evolve" && previousStage is not null)
        {
            <img class="pet-sprite pet-old sprite-@(Species)-@(previousStage)" src="@Sprite(previousStage)" alt="" aria-hidden="true" draggable="false" />
        }
        <span class="pet-ring" aria-hidden="true"></span>
        <span class="pet-effect pet-heart" aria-hidden="true">♥</span>
        <span class="pet-effect pet-star" aria-hidden="true">✦</span>
        <img class="pet-effect pet-food" src="_content/MathPet.UI/pet-assets/items/apple.svg" alt="" aria-hidden="true" />
        <img class="pet-effect pet-toy" src="_content/MathPet.UI/pet-assets/items/ball.svg" alt="" aria-hidden="true" />
    </div>
</div>
@code {
    [Parameter] public string Species { get; set; } = "cat";
    [Parameter] public string Stage { get; set; } = "baby";
    [Parameter] public string Name { get; set; } = "团团猫";
    [Parameter] public bool ReducedMotion { get; set; }
    private string action = "idle";
    private string? lastStage, lastSpecies, previousStage;
    private int serial;
    private bool disposed;
    private CancellationTokenSource? playback;
    private string Sprite(string stage) => $"_content/MathPet.UI/pet-animation/sprites/{Species}-{stage}.png";
    private static int Duration(string value) => value switch
    { "pet" => 1400, "feed" or "play" => 2200, "correct" => 1500, "encourage" => 1600, "upgrade" => 2000, "evolve" => 2600, _ => 0 };
    protected override async Task OnParametersSetAsync()
    {
        if (Species is not ("cat" or "rabbit" or "fox") || Stage is not ("baby" or "young" or "mature"))
            throw new ArgumentException("Unknown pet species or evolution stage.");
        var oldStage = lastStage;
        var changedSpecies = lastSpecies != Species;
        lastStage = Stage; lastSpecies = Species;
        if (changedSpecies) { playback?.Cancel(); action = "idle"; previousStage = null; }
        else if (oldStage is not null && oldStage != Stage)
        {
            previousStage = oldStage;
            await PlayAsync("evolve");
        }
    }
    public async Task PlayAsync(string value)
    {
        if (disposed) return;
        var duration = Duration(value);
        if (duration == 0) throw new ArgumentException("Unknown pet animation.");
        playback?.Cancel();
        var current = new CancellationTokenSource(); playback = current;
        action = value; serial++;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Task.Delay(duration, current.Token);
            if (!disposed && playback == current)
            {
                action = "idle"; previousStage = null; serial++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        finally { if (playback == current) playback = null; current.Dispose(); }
    }
    public void Dispose() { disposed = true; playback?.Cancel(); }
}
