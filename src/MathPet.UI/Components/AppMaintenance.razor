@inject IServiceProvider Services
@if (update is not null && !ShowSettings)
{
<div class="card update-banner" role="status"><b>发现新版本 @update.VersionName</b><p class="muted tiny">前往设置下载更新，安装时无需卸载当前应用。</p><button class="btn secondary" @onclick="() => OnOpenSettings.InvokeAsync()">前往设置更新</button></div>
}
@if (ShowSettings)
{
<div class="card settings" data-testid="app-maintenance">
<h3>应用更新</h3>
<p class="muted tiny">当前版本 @(Platform?.CurrentVersion ?? "0.2.1（网页验证版）")</p>
@if (Platform is not null)
{
<p class="muted tiny">启动时自动检查更新，也可在这里手动检查。</p>
<button class="btn secondary" disabled="@busy" @onclick="Check">检查更新</button>
@if (update is not null)
{
<p>新版本 @update.VersionName 可下载。下载完成后点击 APK，按系统提示确认安装。</p>
<button class="btn" disabled="@busy" @onclick="Download">下载更新 APK</button>
}
@if (message is not null){<p role="status">@message</p>}
}
else{<p class="muted tiny">网页验证版不提供 APK 更新，请在安卓应用中检查更新。</p>}
</div>
}
@code {
    [Parameter] public bool ShowSettings { get; set; }
    [Parameter] public EventCallback OnOpenSettings { get; set; }
    private IAppMaintenance? Platform=>Services.GetService(typeof(IAppMaintenance)) as IAppMaintenance;
    private AppUpdate? update;private string? message;private bool busy;
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender&&Platform is not null){await Check();StateHasChanged();}}
    private async Task Run(Func<Task> action){if(busy)return;busy=true;await InvokeAsync(StateHasChanged);try{await action();}catch{message="操作未完成。请检查网络后重试。";}finally{busy=false;}}
    private Task Check()=>Run(async()=>{try{update=await Platform!.CheckAsync();message=update is null?"当前已是最新版本。":"发现新版本。";}catch{update=null;message="暂时无法检查更新，请检查网络后重试。";}});
    private Task Download()=>Run(()=>Platform!.OpenDownloadAsync(update!));
}
